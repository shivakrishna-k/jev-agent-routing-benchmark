OPENROUTER_API_KEY=sk-or-...        # must start with sk-or-
# Exact OpenRouter model IDs (verify at https://openrouter.ai/models). The runner fails fast on unknown IDs.
LLM_MODEL_A=openai/gpt-5.6-sol
LLM_MODEL_B=anthropic/claude-opus-5
# Pin the exact Jev version; do not use a moving "latest" alias in published results.
JEV_MODEL=typesafe/jev-1.13
